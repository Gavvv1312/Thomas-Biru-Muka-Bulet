# Base URL of the cyclewaste-backend API, including /api.
# Vite only exposes env vars prefixed with VITE_ to client code.
VITE_API_BASE_URL=http://localhost:3000/api

# Address -> coordinates lookup for the partner "Kelola Lokasi" page.
# Leave both blank/unset to use the default free provider (Nominatim/OSM).
# See GEOCODING_SETUP.md for how to switch to Google Maps or Mapbox.
# VITE_GEOCODING_PROVIDER=google
# VITE_GEOCODING_API_KEY=
